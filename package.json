{
  "name": "revera",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only diagnostic anchoring review for synthetic clinical cases.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "dotenv": "16.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.6",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
